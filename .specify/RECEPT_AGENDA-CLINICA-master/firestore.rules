
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura pública para coleções de dados principais
    match /tb_agendamentos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tb_medicos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tb_clinica/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /tb_faltas_data/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Permite que usuários leiam perfis, mas apenas modifiquem os seus
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueia o acesso a outras coleções por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
